# Web Browser MCP — all settings are optional.

# Browser: 'chrome' (installed Google Chrome, default), 'msedge', or 'chromium' (Playwright's bundled
# browser; install it with `playwright install chromium`).
# BROWSER_CHANNEL=chrome

# Show the browser window? Default: visible on desktops (needed to sign in), headless on servers.
# BROWSER_HEADLESS=false

# Where browser profiles (your logins) and state are stored. Default: ~/.web-browser-mcp
# WEB_BROWSER_MCP_CACHE_DIR=/path/to/cache

# Page load timeout in milliseconds (default 30000) and window size.
# BROWSER_TIMEOUT_MS=30000
# BROWSER_VIEWPORT_WIDTH=1366
# BROWSER_VIEWPORT_HEIGHT=900

# Require confirm=true for clicks that look like save/submit/post/delete (default: true).
# BROWSER_CONFIRM_SUBMITS=true

# Restrict which sites may be opened (comma-separated; subdomains included).
# BROWSER_ALLOWED_DOMAINS=linkedin.com,github.com
# BROWSER_BLOCKED_DOMAINS=example-bad.com
# BROWSER_ALLOW_FILE_URLS=false

# LinkedIn safety limits (keep edits at a human pace).
# LINKEDIN_MAX_WRITES_PER_DAY=20
# LINKEDIN_MIN_SECONDS_BETWEEN_WRITES=10
# WEB_BROWSER_MCP_DISABLE_LINKEDIN=false
